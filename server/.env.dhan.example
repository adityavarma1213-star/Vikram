# Copy to server/.env.dhan (git-ignored) or export these in your shell. PLACEHOLDERS ONLY.
# Never commit real values. The access token is valid for 24 hours and must be renewed.
DHAN_ACCESS_TOKEN=PASTE_24_HOUR_ACCESS_TOKEN_HERE
DHAN_CLIENT_ID=PASTE_DHAN_CLIENT_ID_HERE
# Official Dhan instrument list you downloaded yourself (see docs/DHAN_HISTORICAL_DOWNLOADER.md)
DHAN_SCRIP_MASTER_PATH=./data-local/api-scrip-master.csv
# Existing VIKRAM settings the server already needs
DATABASE_URL=postgres://user:password@localhost:5432/vikram
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=you@example.com
